---
const rover = '/projects/autonomous-rover/';
const hexapod = '/projects/hexapod/';
const stops = [
  ['/', 'about', 'About'],
  [rover, 'overview', 'Rover: Overview'],
  [rover, 'course', 'Rover: Course'],
  [rover, 'hardware', 'Rover: Hardware'],
  [rover, 'mechanical-design', 'Rover: Mechanical Design'],
  [rover, 'controls', 'Rover: Controls & Autonomy'],
  [rover, 'perception', 'Rover: Perception'],
  [rover, 'drive-mapping', 'Rover: Drive Mapping & Wheel Control'],
  [rover, 'results', 'Rover: Results'],
  [hexapod, 'overview', 'Hexapod: Overview'],
  [hexapod, 'art-motion', 'Hexapod: Art Motion'],
  [hexapod, 'installation', 'Hexapod: Installation'],
  [hexapod, 'control', 'Hexapod: Control Architecture'],
  [hexapod, 'software-architecture', 'Hexapod: Software Architecture'],
  [hexapod, 'trajectory-generation', 'Hexapod: Trajectories'],
  [hexapod, 'operator-interface', 'Hexapod: Operator Interface & Safeguards'],
  [hexapod, 'logging', 'Hexapod: Logging'],
  [hexapod, 'recorded-telemetry', 'Hexapod: Recorded Telemetry'],
  [hexapod, 'testing', 'Hexapod: Testing & Results'],
  [hexapod, 'telemetry-plots', 'Hexapod: Motion & Motor Load'],
  [hexapod, 'closing', 'Closing'],
];
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const available = stops.some(([p]) => (p.replace(/\/$/, '') || '/') === path);
---

{available && <>
  <button id="presentation-start" type="button" hidden title="Start presentation" aria-label="Start presentation">&#9654; Present</button>
  <nav id="presentation-navigation" aria-label="Presentation navigation" hidden>
    <button id="presentation-previous" type="button" title="Previous section (Left Arrow)" aria-label="Previous section">&larr;</button>
    <select id="presentation-section" aria-label="Presentation section">
      {stops.map(([page, anchor, label], i) => <option value={`${page}?present=1#${anchor}`} data-page={page} data-anchor={anchor}>{i + 1}. {label}</option>)}
    </select>
    <button id="presentation-next" type="button" title="Next section (Right Arrow)" aria-label="Next section">&rarr;</button>
    <button id="presentation-exit" type="button" title="Exit presentation (Escape)" aria-label="Exit presentation">&times;</button>
  </nav>
</>}

<style is:global>
  #presentation-start { position: fixed; bottom: 1rem; right: 1rem; z-index: 65; padding: .6rem .9rem; font: inherit; font-size: .8rem; }
  #presentation-navigation { position: fixed; bottom: max(1rem, env(safe-area-inset-bottom)); left: 50%; transform: translateX(-50%); z-index: 70; display: flex; gap: .35rem; padding: .4rem; width: min(36rem, calc(100% - 1rem)); background: var(--site-bg); border: 1px solid var(--site-border); border-radius: 8px; box-shadow: 0 3px 14px #0002; }
  #presentation-navigation[hidden], #presentation-start[hidden] { display: none; }
  #presentation-navigation button, #presentation-start, #presentation-section { background: var(--site-surface-raised); color: var(--site-text); border: 1px solid var(--site-border); border-radius: 6px; cursor: pointer; }
  #presentation-navigation button { flex: 0 0 42px; height: 42px; font-size: 1.5rem; line-height: 1; }
  #presentation-section { min-width: 0; flex: 1; font: inherit; font-size: .8rem; padding: 0 .4rem; text-overflow: ellipsis; }
  #presentation-navigation button:hover:not(:disabled), #presentation-start:hover { background: var(--site-chip); }
  #presentation-navigation button:disabled { opacity: .35; cursor: default; }
  #presentation-navigation :focus-visible, #presentation-start:focus-visible { outline: 2px solid var(--accent-color, #1d4ed8); outline-offset: 2px; }
  html[data-present] { scroll-behavior: auto !important; overflow: hidden; }
  html[data-present] [id] { scroll-margin-top: 0 !important; }
  html[data-present] [data-presentation-source] { display: none !important; }
  #presentation-stage { position: fixed; inset: 0 0 82px; padding: 28px 40px; overflow: auto; background: var(--site-bg); z-index: 66; display: flex; flex-direction: column; }
  #presentation-stage[hidden] { display: none; }
  .presentation-slide { width: 100%; max-width: 1280px; margin: auto; flex-shrink: 0; color: var(--site-text); font-size: 1rem; line-height: 1.6; letter-spacing: 0; }
  .presentation-slide > * { margin: 0 !important; min-width: 0; }
  .presentation-slide h1 { font-size: 2.25rem; line-height: 1.2; margin-bottom: 1.25rem; }
  #presentation-stage h2 { font-size: 1.75rem; line-height: 1.25; margin-bottom: 1.25rem; }
  .presentation-slide h3 { font-size: 1.125rem; line-height: 1.4; }
  .presentation-slide #perception > h3, .presentation-slide #drive-mapping > h3, .presentation-slide #wheel-control > h3, .presentation-slide #safeguards > h3 { font-size: 1.75rem; line-height: 1.25; margin-bottom: 1.25rem; }
  .presentation-slide .border { border-color: var(--site-border); }
  .presentation-slide .shadow-sm, .presentation-slide .shadow-md { box-shadow: none; }
  .presentation-slide img, .presentation-slide video { width: 100%; height: auto; object-fit: contain; max-height: 460px; margin-inline: auto; }
  .presentation-slide figure { margin-inline: auto; }
  .presentation-slide figcaption { font-size: .8125rem; line-height: 1.5; color: var(--site-soft); margin-top: .75rem; }
  .presentation-slide .points { line-height: 1.5; }
  .presentation-slide .points li + li { margin-top: .5rem; }
  .presentation-slide #about { padding: 0; }
  .presentation-slide #about .grid { grid-template-columns: minmax(0, 1fr); gap: 1rem; }
  .presentation-slide #about .grid > div { grid-column: 1; }
  #presentation-stage #about h2 { font-size: 2.625rem; margin-bottom: 0; }
  .presentation-slide #about p { font-size: 2.5rem; line-height: 1.2; margin-bottom: 1rem; }
  .presentation-slide #overview video { max-height: calc(100dvh - 390px); }
  .presentation-slide #overview .overview-images img { height: min(300px, calc(100dvh - 450px)); }
  .presentation-slide #art-motion video { max-height: calc(100dvh - 190px); }
  .presentation-slide #recorded-telemetry img { max-height: calc(100dvh - 220px); }
  .presentation-slide #installation { display: grid; grid-template-columns: 1.4fr 1fr; gap: 1rem 2rem; align-items: center; }
  .presentation-slide #installation h2 { grid-column: 1 / -1; }
  .presentation-slide #installation figure, .presentation-slide #installation ul { margin: 0; }
  .presentation-slide #hardware img { max-height: 250px; }
  .presentation-slide #mechanical-design img { max-height: 235px; }
  .presentation-slide #results video { max-height: 245px; }
  .presentation-slide #controls > div { margin: 0; }
  .presentation-slide #ros-architecture { margin-top: 1rem; }
  .presentation-slide #ros-architecture figure { margin-block: .5rem; }
  .presentation-slide #ros-architecture svg { width: auto; min-width: 0; max-width: 100%; height: calc(100dvh - 350px); margin-inline: auto; }
  .presentation-slide #trajectory-generation { display: grid; grid-template-columns: 1.8fr 1fr; gap: 1rem 2rem; align-items: center; }
  .presentation-slide #trajectory-generation > * { margin-block: 0; }
  .presentation-slide #trajectory-generation h2 { grid-column: 1 / -1; }
  .presentation-slide #trajectory-generation img { max-height: calc(100dvh - 270px); }
  .presentation-slide #trajectory-generation ul { margin: 0; }
  .presentation-slide[data-slide="perception"], .presentation-slide[data-slide="drive-mapping"], .presentation-slide[data-slide="operator-interface"] { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; align-items: start; }
  .presentation-slide #dashboard img { max-height: 300px; }
  .presentation-slide #safeguards table { font-size: .8rem; line-height: 1.4; }
  .presentation-slide #safeguards th, .presentation-slide #safeguards td { padding: .6rem; }
  .presentation-slide #telemetry-plots { padding-top: 0; }
  .presentation-slide #testing > figure { margin-block: .5rem; }
  .presentation-slide #testing > figure img { max-height: calc(100dvh - 350px); }
  .presentation-slide #testing > .points { font-size: 1rem; }
  .presentation-slide #telemetry-plots img { max-height: calc(100dvh - 250px); }
  #closing { display: none; }
  .presentation-slide #closing { display: block; }
  .presentation-slide #closing .closing-projects { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2rem; }
  .presentation-slide #closing h3 { margin-bottom: .75rem; }
  .presentation-slide #closing video { height: min(350px, calc(100dvh - 360px)); background: #111; }
  .presentation-slide #closing ul { margin-top: 1rem; }
  @media (max-width: 767px) {
    #presentation-stage { padding: 20px 16px; }
    .presentation-slide { margin-block: 0; }
    .presentation-slide[data-slide], .presentation-slide #installation, .presentation-slide #trajectory-generation { display: block; }
    .presentation-slide > * + *, .presentation-slide #trajectory-generation ul { margin-top: 1.5rem !important; }
    .presentation-slide #overview video { max-height: 420px; }
    .presentation-slide #overview .overview-images img { height: auto; max-height: 300px; }
    .presentation-slide #closing .closing-projects { grid-template-columns: 1fr; }
    .presentation-slide #closing video { height: auto; max-height: 300px; }
    .presentation-slide #testing > figure img { max-height: none; }
    .presentation-slide #ros-architecture svg { width: 100%; height: auto; max-height: none; }
  }
  @media print { #presentation-navigation, #presentation-start { display: none !important; } }
</style>

<script>
  const start = document.querySelector<HTMLButtonElement>('#presentation-start');
  const navigation = document.querySelector<HTMLElement>('#presentation-navigation');
  const select = document.querySelector<HTMLSelectElement>('#presentation-section');
  const previous = document.querySelector<HTMLButtonElement>('#presentation-previous');
  const next = document.querySelector<HTMLButtonElement>('#presentation-next');
  const exit = document.querySelector<HTMLButtonElement>('#presentation-exit');
  if (start && navigation && select && previous && next && exit) {
    const options = Array.from(select.options);
    const stage = document.createElement('main');
    stage.id = 'presentation-stage';
    stage.hidden = true;
    stage.setAttribute('aria-label', 'Current presentation slide');
    const slide = document.createElement('div');
    slide.className = 'presentation-slide';
    stage.append(slide);
    document.body.append(stage);
    for (const child of document.body.children) {
      if (![stage, navigation, start].includes(child as HTMLElement) && !['SCRIPT', 'STYLE'].includes(child.tagName)) child.setAttribute('data-presentation-source', '');
    }
    // Move the real nodes, preserving media controls, SVG references and event listeners.
    // Placeholders restore the exact portfolio DOM when navigating or exiting.
    const moved: { node: HTMLElement; placeholder: Comment }[] = [];
    const restore = () => {
      for (const { node, placeholder } of moved.splice(0).reverse()) placeholder.replaceWith(node);
    };
    const move = (node: HTMLElement, destination?: HTMLElement) => {
      const placeholder = document.createComment('presentation position');
      node.replaceWith(placeholder);
      moved.push({ node, placeholder });
      destination?.append(node);
    };
    const groups: Record<string, string[]> = {
      perception: ['perception', 'perception-output'],
      'drive-mapping': ['drive-mapping', 'wheel-control'],
      'operator-interface': ['operator-interface', 'safeguards'],
    };
    const exclusions: Record<string, string[]> = {
      controls: ['perception', 'perception-output', 'drive-mapping', 'wheel-control'],
      control: ['software-architecture'],
      logging: ['recorded-telemetry'],
      testing: ['telemetry-plots'],
    };
    const normalize = (path: string) => path.replace(/\/$/, '') || '/';
    const localStops = options.flatMap((option, index) => {
      if (normalize(option.dataset.page!) !== normalize(location.pathname)) return [];
      const element = document.getElementById(option.dataset.anchor!);
      return element ? [{ index, element }] : [];
    });
    let active = new URL(location.href).searchParams.get('present') === '1';
    let index = localStops.find(stop => '#' + stop.element.id === location.hash)?.index ?? localStops[0]?.index ?? 0;
    const update = () => {
      select.selectedIndex = index;
      previous.disabled = index === 0;
      next.disabled = index === options.length - 1;
    };
    const setMode = (enabled: boolean) => {
      active = enabled;
      document.documentElement.toggleAttribute('data-present', enabled);
      start.hidden = enabled;
      navigation.hidden = !enabled;
      stage.hidden = !enabled;
      if (!enabled && moved.length) {
        document.querySelectorAll('video').forEach(video => video.pause());
        restore();
        document.getElementById(options[index].dataset.anchor!)?.scrollIntoView();
      }
      const url = new URL(location.href);
      if (enabled) url.searchParams.set('present', '1');
      else url.searchParams.delete('present');
      history.replaceState(null, '', url);
      update();
    };
    const jump = (target: number) => {
      if (target < 0 || target >= options.length) return;
      document.querySelectorAll('video').forEach(video => video.pause());
      restore();
      const url = new URL(options[target].value, location.origin);
      if (normalize(url.pathname) !== normalize(location.pathname)) {
        location.assign(url.href);
        return;
      }
      const element = document.getElementById(options[target].dataset.anchor!);
      if (!element) return;
      index = target;
      history.replaceState(null, '', url);
      const anchor = element.id;
      slide.dataset.slide = anchor;
      stage.setAttribute('aria-label', options[target].textContent!);
      for (const id of exclusions[anchor] ?? []) {
        const child = element.querySelector<HTMLElement>(`#${id}`);
        if (child) move(child);
      }
      for (const id of groups[anchor] ?? [anchor]) {
        const child = document.getElementById(id);
        if (child) move(child, slide);
      }
      stage.scrollTop = 0;
      stage.querySelectorAll<HTMLImageElement>('img').forEach(img => { img.loading = 'eager'; });
      // Start the selected clip, but leave playback controls available to the presenter.
      for (const video of element.querySelectorAll<HTMLVideoElement>('video')) {
        video.muted = true;
        video.playsInline = true;
        video.currentTime = 0;
        void video.play().catch(() => { /* Native play control remains available. */ });
      }
      update();
    };
    start.addEventListener('click', () => { setMode(true); jump(index); });
    previous.addEventListener('click', () => jump(index - 1));
    next.addEventListener('click', () => jump(index + 1));
    select.addEventListener('change', () => jump(select.selectedIndex));
    const exitPresentation = () => {
      setMode(false);
      location.assign('/#projects');
    };
    exit.addEventListener('click', exitPresentation);
    window.addEventListener('keydown', event => {
      if (!active || event.altKey || event.ctrlKey || event.metaKey || event.shiftKey) return;
      if (event.key === 'Escape') {
        event.preventDefault();
        exitPresentation();
        return;
      }
      if (event.target instanceof Element && event.target.closest('input, textarea, select, video, [contenteditable="true"]')) return;
      if (['ArrowRight', 'PageDown', 'ArrowLeft', 'PageUp'].includes(event.key)) {
        event.preventDefault();
        jump(index + (['ArrowRight', 'PageDown'].includes(event.key) ? 1 : -1));
      }
    });
    setMode(active);
    if (active) requestAnimationFrame(() => jump(index));
  }
</script>
