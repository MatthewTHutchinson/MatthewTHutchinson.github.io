---
import { siteConfig } from "../config";
const path = Astro.url.pathname.replace(/\/$/, "");
const project = [...siteConfig.projects, ...siteConfig.archivedProjects].find(
  (item) => item.link === path,
);
---

{project && (
  <ul class="flex flex-wrap gap-2 mt-5" aria-label="Project technologies">
    {project.skills.map((skill) => (
      <li class="bg-gray-100 text-gray-700 border border-gray-200 px-2.5 py-1 rounded text-xs sm:text-sm leading-5 font-medium">{skill}</li>
    ))}
  </ul>
)}
