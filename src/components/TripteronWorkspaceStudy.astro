---
import { siteConfig } from "../config";
const { samples, commonY, grid, hingeBuffer, railBuffer } = siteConfig.tripteronStudy;
const x = (z: number) => 60 + ((z - 25) / 125) * 620;
const y = (area: number) => 260 - (area / 200) * 220;
const points = samples.map(([z, area]) => `${x(z)},${y(area)}`).join(" ");
---

<figure class="rounded-xl border border-gray-200 bg-gray-50 p-4 sm:p-6">
  <h3 class="font-bold mb-2">Connected sideways / depth workspace</h3>
  <p class="text-sm text-gray-600 mb-4">Two mirrored platforms carrying a level light at Y = {commonY} mm</p>
  <svg viewBox="0 0 720 320" class="w-full h-auto" role="img" aria-labelledby="tripteron-study-title tripteron-study-desc">
    <title id="tripteron-study-title">Shared translation area versus default Z depth</title>
    <desc id="tripteron-study-desc">Area peaks at 172.25 square centimetres for the tested 65 millimetre default, compared with 169.75 at 75 millimetres. A data table follows.</desc>
    {[0, 50, 100, 150, 200].map((value) => (
      <g>
        <line x1="60" x2="680" y1={y(value)} y2={y(value)} stroke="#d1d5db" />
        <text x="48" y={y(value) + 5} text-anchor="end" font-size="14" fill="currentColor">{value}</text>
      </g>
    ))}
    {[25, 50, 75, 100, 125, 150].map((value) => (
      <text x={x(value)} y="283" text-anchor="middle" font-size="14" fill="currentColor">{value}</text>
    ))}
    <polyline points={points} fill="none" stroke="currentColor" stroke-width="3" />
    {samples.map(([z, area]) => (
      <circle cx={x(z)} cy={y(area)} r="4" fill="currentColor"><title>Z = {z} mm: {area} cm²</title></circle>
    ))}
    <text x="370" y="311" text-anchor="middle" font-size="14" fill="currentColor">Default Z per robot (mm)</text>
    <text transform="translate(16 150) rotate(-90)" text-anchor="middle" font-size="14" fill="currentColor">Area (cm²)</text>
  </svg>
  <figcaption class="text-sm leading-relaxed text-gray-600 mt-4">Model study: {grid} mm position grid, {hingeBuffer} mm hinge-span buffer, and {railBuffer} mm rail buffer. Area estimates use the component connected to the starting pose, with continuous edge checks. Robot and light-strip collisions are excluded.</figcaption>
  <details class="mt-4 text-sm">
    <summary class="cursor-pointer font-medium py-2">View study values</summary>
    <table class="w-full mt-2 text-left">
      <caption class="sr-only">October 2026 paired-platform workspace samples</caption>
      <thead><tr class="border-b border-gray-300"><th scope="col" class="py-2">Default Z (mm)</th><th scope="col" class="py-2">Connected area (cm²)</th></tr></thead>
      <tbody>{samples.map(([z, area]) => <tr class="border-b border-gray-200"><th scope="row" class="py-2 font-normal">{z}</th><td class="py-2">{area.toFixed(2)}</td></tr>)}</tbody>
    </table>
  </details>
</figure>
