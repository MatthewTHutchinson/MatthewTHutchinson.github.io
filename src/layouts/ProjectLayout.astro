---
// src/layouts/ProjectLayout.astro
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import BackgroundLayer from "../components/BackgroundLayer.astro";
import "../styles/global.css";
import { siteConfig } from "../config";
const path = Astro.url.pathname.replace(/\/$/, "");
const project = [...siteConfig.projects, ...siteConfig.archivedProjects].find((item) => item.link === path);
const title = Astro.props.title ?? project?.name ?? "Project";
const description = project?.description ?? siteConfig.description;
const archived = siteConfig.archivedProjects.some((item) => item.link === path);
---

<!DOCTYPE html>
<html lang="en" style={`--accent-color: ${siteConfig.accentColor}`}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | {siteConfig.name}</title>
    <meta name="description" content={description} />

    <!-- Global Fonts (IBM Plex Mono) -->      
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;1,100;1,200;1,300;1,400;1,500;1,600;1,700&display=swap"
      rel="stylesheet"
    />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon_v2.svg" />

    <style>
      html {
        scroll-behavior: smooth;
      }
    </style>
  </head>

  <body class="bg-white text-gray-900 font-sans relative">
    <BackgroundLayer />
    <Header />

    <main class="relative z-10 max-w-4xl mx-auto px-4 pt-48 pb-32">
      {archived && <p class="mb-8 text-sm text-gray-500">Archived Project · <a class="underline underline-offset-4" href="/projects/archive">Project Archive</a></p>}
      <slot />
    </main>

    <Footer />
  </body>

</html>
