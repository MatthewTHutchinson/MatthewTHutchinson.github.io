---
import ProjectLayout from "../../layouts/ProjectLayout.astro";
import { siteConfig } from "../../config";
---

<ProjectLayout title="Project Archive">
  <h1 class="text-4xl sm:text-5xl font-bold mb-10">Project Archive</h1>
  <div class="divide-y divide-gray-200">
    {siteConfig.archivedProjects.map((project) => (
      <article class="py-8 space-y-4">
        <h2 class="text-2xl font-semibold"><a class="underline underline-offset-4" href={project.link}>{project.name}</a></h2>
        <p class="text-gray-600 leading-relaxed">{project.description}</p>
        <ul class="flex flex-wrap gap-2" aria-label={`${project.name} technologies`}>
          {project.skills.map((skill) => <li class="bg-gray-900 text-white rounded-md px-3 py-1 text-sm">{skill}</li>)}
        </ul>
      </article>
    ))}
  </div>
  <a href="/#projects" class="inline-block mt-10 underline underline-offset-4">Back to Selected Projects</a>
</ProjectLayout>
