---
import ProjectLayout from "../../layouts/ProjectLayout.astro";
import ProjectTags from "../../components/ProjectTags.astro";
---

<ProjectLayout>
  <section class="mb-12">
    <div class="flex flex-col gap-6">
      <div>
        <h1 class="text-4xl sm:text-5xl font-bold mb-4">Laser-Cut Japanese Pagoda</h1>
        <p class="text-lg text-gray-700 max-w-3xl">
          A lantern inspired by Japanese pagoda architecture, made from laser-cut wood joinery, acrylic light panels, and surface engraving.
        </p>
        <ProjectTags />
      </div>

      <figure class="rounded-lg overflow-hidden shadow-md border border-gray-200">
        <img
          src="/media/makerspace work/lantern-1.JPG"
          alt="Japanese pagoda lantern"
          class="w-full h-auto"
        />
      </figure>
    </div>
  </section>

  <section class="mb-12">
    <h2 class="text-2xl font-bold mb-6">Photos</h2>
    <div class="grid grid-cols-2 sm:grid-cols-3 gap-4">
      {[
        "lantern-2.JPG",
        "lantern-3.JPG",
        "lantern-5.jpg",
        "lantern-8.JPG",
        "lantern-9.jpg",
        "lantern-12.jpg",
        "lantern-13.jpg",
        "lantern-14.jpg",
        "lantern-16.jpg",
        "lantern-17.jpg",
        "lantern-18.jpg",
        "lantern-19.jpg",
        "lantern-20.jpg",
        "lantern-21.jpg",
      ].map((filename) => (
        <figure class="rounded-lg overflow-hidden border border-gray-200 shadow-sm">
          <img
            src={`/media/makerspace work/${filename}`}
            alt="Laser-cut pagoda lantern construction detail"
            class="w-full h-auto"
            loading="lazy"
          />
        </figure>
      ))}
    </div>
  </section>
</ProjectLayout>
