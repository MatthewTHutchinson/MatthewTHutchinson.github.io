---
import ProjectLayout from "../../layouts/ProjectLayout.astro";
import ProjectTags from "../../components/ProjectTags.astro";
---

<ProjectLayout>
  <section class="mb-12">
    <div class="flex flex-col gap-6">
      <div>
        <h1 class="text-4xl sm:text-5xl font-bold mb-4">MapLaser</h1>
        <p class="text-lg text-gray-700 max-w-3xl">
          A Python pipeline that converts geographic data into layered SVG maps for laser fabrication. I built configurable cropping, rotation, road buffering, and layer export, extending earlier city and campus maps I made at the UCLA Makerspace.
        </p>
        <ProjectTags />
      </div>

      <figure class="rounded-lg overflow-hidden shadow-md border border-gray-200">
        <img
          src="/images/makerspace work/sf-map-1.jpeg"
          alt="Laser-cut San Francisco map"
          class="w-full h-auto"
        />
        <figcaption class="px-3 py-1.5 text-xs text-gray-400 font-mono">Earlier laser-cut San Francisco map, made at the UCLA Makerspace.</figcaption>
      </figure>
    </div>
  </section>

  <section class="mb-12 space-y-4">
    <h2 class="text-2xl font-bold">What I Built</h2>
    <ul class="list-disc pl-5 space-y-3 text-gray-700 leading-relaxed">
      <li>Combined OpenStreetMap roads and NYC shoreline data in a projected coordinate system before scaling the output to physical dimensions.</li>
      <li>Built recipe-based controls for crop, rotation, road classes, layer selection, and minimum physical road width.</li>
      <li>Handled clipping and road buffering while preserving bridges and other connections that can disappear when roads are clipped only to land.</li>
      <li>Exported named SVG layers for cutting, engraving, and alignment, with Illustrator cleanup and material test cuts as part of the fabrication workflow.</li>
    </ul>
    <figure class="pt-4">
      <img src="/images/maplaser/nyc-map.png" alt="Generated NYC map in Illustrator with road, shoreline, and transit layers" class="w-full h-auto" loading="lazy" />
      <figcaption class="mt-3 text-sm text-gray-500">NYC composition in Illustrator. This is a digital design preview; the photographs below show earlier fabricated maps.</figcaption>
    </figure>
  </section>

  <section class="mb-12">
    <h2 class="text-2xl font-bold mb-2">San Francisco Maps</h2>
    <p class="text-gray-500 text-sm mb-6 font-mono">sf-map series</p>
    <div class="grid grid-cols-2 sm:grid-cols-3 gap-4">
      {[
        "sf-map-2.JPG",
        "sf-map-3.JPG",
        "sf-map-4.JPG",
        "sf-map-5.jpg",
        "sf-map-6.jpg",
      ].map((filename) => (
        <figure class="rounded-lg overflow-hidden border border-gray-200 shadow-sm">
          <img
            src={`/images/makerspace work/${filename}`}
            alt={filename}
            class="w-full h-auto"
            loading="lazy"
          />
          <figcaption class="px-2 py-1 text-xs text-gray-400 font-mono">{filename}</figcaption>
        </figure>
      ))}
    </div>
  </section>

  <section class="mb-12">
    <h2 class="text-2xl font-bold mb-2">UCLA Campus Map</h2>
    <p class="text-gray-500 text-sm mb-6 font-mono">ucla-map series</p>
    <div class="grid grid-cols-2 sm:grid-cols-3 gap-4">
      {[
        "ucla-map.JPG",
        "ucla-map-2.jpg",
        "ucla-map-3.JPG",
        "ucla-map-4.JPG",
        "ucla-map-5.jpg",
      ].map((filename) => (
        <figure class="rounded-lg overflow-hidden border border-gray-200 shadow-sm">
          <img
            src={`/images/makerspace work/${filename}`}
            alt={filename}
            class="w-full h-auto"
            loading="lazy"
          />
          <figcaption class="px-2 py-1 text-xs text-gray-400 font-mono">{filename}</figcaption>
        </figure>
      ))}
    </div>
  </section>
</ProjectLayout>
