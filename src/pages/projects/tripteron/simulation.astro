---
import play from '@tabler/icons/outline/player-play.svg?raw';
import pause from '@tabler/icons/outline/player-pause.svg?raw';
import reset from '@tabler/icons/outline/rotate-2.svg?raw';
import fit from '@tabler/icons/outline/focus-2.svg?raw';
import fullscreen from '@tabler/icons/outline/arrows-maximize.svg?raw';
import back from '@tabler/icons/outline/arrow-left.svg?raw';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Interactive Tripteron CAD assembly with offline single and paired kinematic motion." />
    <link rel="icon" href="/favicon_v2.svg" type="image/svg+xml" />
    <title>Tripteron Motion | Matthew Hutchinson</title>
  </head>
  <body>
    <main id="simulation" data-state="loading">
      <header>
        <a class="icon" href="/projects/tripteron/#simulation" target="_top" title="Tripteron project" aria-label="Tripteron project" set:html={back} />
        <h1>Tripteron <span>CAD motion</span></h1>
        <button class="icon" id="fullscreen" title="Full screen" aria-label="Full screen" set:html={fullscreen} />
      </header>
      <div class="toolbar" aria-label="Scene controls">
        <fieldset class="segments"><legend class="sr-only">Assembly</legend>
          <label><input type="radio" name="assembly" value="pair" checked /><span>Pair</span></label>
          <label><input type="radio" name="assembly" value="single" /><span>Single</span></label>
        </fieldset>
        <label class="select-label"><span class="sr-only">Motion</span><select id="motion" disabled><option value="tour">Workspace tour</option><option value="sweep">X / Z sweep</option><option value="line">Straight line</option><option value="manual">Manual control</option></select></label>
        <label class="select-label"><span class="sr-only">Camera</span><select id="camera"><option value="iso">Isometric</option><option value="front">Front</option><option value="side">Side</option><option value="top">Top</option></select></label>
        <button class="icon" id="fit" title="Fit assembly" aria-label="Fit assembly" set:html={fit} />
        <label class="check"><input id="path" type="checkbox" />Path</label>
        <label class="check"><input id="follow" type="checkbox" checked />Follow</label>
        <label class="check"><input id="plots" type="checkbox" checked />Plots</label>
      </div>
      <section id="manual-controls" aria-label="Manual platform position" hidden>
        <div class="manual-heading">
          <fieldset class="segments"><legend class="sr-only">Move platform</legend>
            <label><input type="radio" name="manual-robot" value="0" checked /><span>A</span></label>
            <label><input type="radio" name="manual-robot" value="1" /><span>B</span></label>
          </fieldset>
          <button class="icon" id="manual-home" title="Return selected platform toward reference" aria-label="Return selected platform toward reference" set:html={reset} />
          <output id="manual-status" role="status">mm from reference</output>
        </div>
        <div class="manual-axes">
          {['X', 'Y', 'Z'].map((axis, index) => (
            <div class="manual-axis" style={`--axis-color: ${['#bd563f', '#167d83', '#4b68ae'][index]}`}>
              <label for={`manual-${axis}`} title={['Left / right', 'Up / down', 'In / out'][index]}>{axis}</label>
              <input id={`manual-${axis}`} type="range" min="-1" max="1" step="0.1" value="0" aria-label={`${axis} ${['left / right', 'up / down', 'in / out'][index]}`} />
              <input id={`manual-${axis}-value`} type="number" step="1" value="0" inputmode="decimal" aria-label={`${axis} displacement in millimetres`} />
            </div>
          ))}
        </div>
      </section>
      <div class="workbench">
      <div id="viewport">
        <canvas id="scene" aria-label="Interactive 3D Tripteron assembly" tabindex="0"></canvas>
        <div id="status" role="status"><span>Loading CAD assembly...</span><button id="retry" hidden>Reload</button></div>
        <output id="coordination" class="phase-readout">Together · fixed span</output>
        <div class="readout" aria-label="Robot A displacement from CAD reference"><span>A</span><output id="position">X 0 &nbsp; Y 0 &nbsp; Z 0 mm</output></div>
        <span class="axes-label">Y up · X lateral · Z outward</span>
      </div>
      <aside id="analysis" aria-label="Synchronized motion analysis">
        <div class="analysis-header"><span>Local frame</span>
          <fieldset class="segments"><legend class="sr-only">Plot robot</legend><label><input type="radio" name="plot-robot" value="0" checked /><span>A</span></label><label id="robot-b-choice"><input type="radio" name="plot-robot" value="1" /><span>B</span></label></fieldset>
        </div>
        <section class="plot-section">
          <h2>Workspace <output id="slice-height">Y = 0 mm</output></h2>
          <canvas id="workspace-plot" role="img" aria-label="XZ workspace slice at the current platform height"></canvas>
          <div class="plot-legend"><span><i class="swatch available"></i>Current height</span><span><i class="swatch excluded"></i>Other heights</span></div>
          <p class="plot-caption">5 mm samples · hinge, rail and clearance guards</p>
        </section>
        <section class="plot-section">
          <h2>Platform displacement <span>mm · 1x time</span></h2>
          <canvas id="position-plot" role="img" aria-label="Platform X, Y and Z displacement over time, each on its own scale"></canvas>
          <p class="plot-caption">Separate axis scales · <output id="nominal-speed">0 mm/s</output> at 1x</p>
        </section>
        <section class="plot-section">
          <h2>Carriage displacement</h2>
          <canvas id="carriage-plot" role="img" aria-label="M, L and R carriage displacements against rail travel bounds"></canvas>
          <p class="plot-caption">From CAD reference · <output id="rail-margin">Rail margin -- mm</output></p>
        </section>
      </aside>
      </div>
      <div class="playback" aria-label="Playback controls">
        <button class="icon" id="play" title="Pause" aria-label="Pause" disabled><span class="play-icon" set:html={play} /><span class="pause-icon" set:html={pause} /></button>
        <button class="icon" id="reset" title="Return to reference" aria-label="Return to reference" disabled set:html={reset} />
        <input id="timeline" type="range" min="0" max="540" step="1" value="0" aria-label="Motion position" disabled />
        <output id="time">0.0 / 18.0 s</output>
        <label><span class="sr-only">Playback speed</span><select id="speed"><option value="0.5">0.5x</option><option value="1" selected>1x</option><option value="2">2x</option></select></label>
      </div>
      <details id="model-details">
        <summary>Offline kinematics <span>2,000 mm rail study</span></summary>
        <div class="model-notes">
          <p>The original linkage CAD is unchanged. The source rail profile and 40 mm hole pattern are repeated to 2,000 mm. Unattached fixed hardware is omitted. This is a design study, not an updated hardware calibration.</p>
          <dl id="ranges"></dl>
          <p>The tour combines XZ loops with changing height, first together and then in opposite world directions. Both robots return to reference between phases. XZ paths have a 0.5% inward margin; each displayed segment is checked in both robots' local frames. The X / Z sweep holds Y constant. Neither is an exhaustive workspace scan.</p>
          <p>The together phase keeps a rigid 1 m span level. Opposing motion uses independent platforms with no connecting bar: opposite in/out motion cannot preserve a rigid span. Opposing height excursions are limited to 250 mm each. This is a choreography study, not a model of a flexible or telescoping light.</p>
          <p>Bounds use a 5 mm carriage inset, provisional 15-163 degree hinge angles, and 2 mm conservative carriage-order and platform-front clearance guards derived from CAD body bounds. Manual motion checks each entire straight move and stops at the first limit. Paired manual platforms move independently with no bar.</p>
          <p>All plots switch between robot A and B in their own local frame. Shading shows individual sampled endpoint feasibility, not a jointly feasible or connected path. Graphs are computed motion, not sensor telemetry.</p>
          <p>Plot time and speed use nominal 1x playback. Motion timing is illustrative, not motor-rated. Robot B's local X and Z point opposite robot A's world directions.</p>
          <p>These guards are not a complete collision model or measured hardware limits. Link-to-link contact, belts, loads, attachment geometry and tracking error are not simulated. This page cannot command hardware.</p>
        </div>
      </details>
      <noscript>Enable JavaScript to view the 3D assembly.</noscript>
    </main>
    <script>
      import '../../../scripts/tripteron-simulation';
    </script>
  </body>
</html>

<style is:global>
  :root { color-scheme: light; font-family: 'IBM Plex Mono', ui-monospace, SFMono-Regular, Consolas, monospace; font-size: 13px; color: #222c30; background: #f6f8f8; }
  * { box-sizing: border-box; letter-spacing: 0; }
  body { margin: 0; }
  button, select, input { font: inherit; color: inherit; }
  button, select { cursor: pointer; }
  button:disabled, input:disabled, select:disabled { opacity: .45; cursor: wait; }
  :focus-visible { outline: 2px solid #007d80; outline-offset: 3px; }
  #simulation { height: 100dvh; min-height: 380px; display: grid; grid-template-rows: auto auto auto minmax(140px, 1fr) auto auto; }
  header { grid-row: 1; } .toolbar { grid-row: 2; } #manual-controls { grid-row: 3; } .workbench { grid-row: 4; } .playback { grid-row: 5; } #model-details { grid-row: 6; }
  #manual-controls { padding: 8px 16px; border-bottom: 1px solid #dce2e3; background: #fafcfc; }
  #manual-controls[hidden] { display: none; }
  .manual-heading { display: flex; align-items: center; gap: 8px; min-height: 30px; margin-bottom: 4px; }
  .manual-heading .segments span { padding: 3px 10px; }
  .manual-heading .icon { width: 28px; height: 28px; flex-basis: 28px; padding: 4px; }
  #manual-status { color: #536168; font-size: 11px; }
  #manual-status[data-limited] { color: #9c442b; }
  #simulation[data-manual="true"] .playback,
  #simulation[data-manual="true"] .check:has(#path),
  #simulation[data-manual="true"] .plot-section:has(#position-plot) { display: none; }
  .manual-axes { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }
  .manual-axis { display: grid; grid-template-columns: 18px minmax(70px, 1fr) 76px; align-items: center; gap: 8px; min-width: 0; }
  .manual-axis label { color: var(--axis-color); font-weight: 600; }
  .manual-axis input[type="range"] { width: 100%; margin: 0; accent-color: var(--axis-color); }
  .manual-axis input[type="number"] { width: 100%; height: 28px; border: 1px solid #c5d0d2; border-radius: 3px; background: white; padding: 3px 5px; font-variant-numeric: tabular-nums; }
  header { display: flex; align-items: center; gap: 12px; padding: 8px 16px; border-bottom: 1px solid #dce2e3; }
  h1 { font-size: 16px; font-weight: 600; margin: 0; flex: 1; }
  h1 span { font-size: 12px; font-weight: 400; margin-left: 10px; color: #5c696e; }
  .icon { width: 36px; height: 36px; flex: 0 0 36px; display: inline-flex; justify-content: center; align-items: center; background: transparent; border: 1px solid transparent; border-radius: 4px; text-decoration: none; color: inherit; padding: 7px; }
  .icon:hover { background: #e4ebeb; border-color: #cbd6d7; }
  .icon svg { width: 21px; height: 21px; display: block; padding: 0; border: 0; background: none; }
  .toolbar { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; padding: 8px 16px; border-bottom: 1px solid #dce2e3; }
  .segments { border: 1px solid #c5d0d2; padding: 2px; display: flex; gap: 2px; margin: 0; border-radius: 4px; }
  .segments label { position: relative; cursor: pointer; }
  .segments input { position: absolute; opacity: 0; }
  .segments span { display: block; padding: 6px 12px; border-radius: 2px; }
  .segments input:checked + span { background: #315e63; color: white; }
  .segments input:focus-visible + span { outline: 2px solid #007d80; outline-offset: 1px; }
  select { height: 36px; border: 1px solid #c5d0d2; border-radius: 4px; background: #fff; padding: 0 8px; max-width: 100%; }
  .check { display: flex; align-items: center; gap: 5px; padding-inline: 4px; }
  input { accent-color: #267d83; }
  #viewport { position: relative; overflow: hidden; min-height: 0; }
  .workbench { min-height: 0; display: grid; grid-template-columns: minmax(0, 1fr) 330px; overflow: hidden; }
  #simulation[data-plots="off"] .workbench { grid-template-columns: minmax(0, 1fr); }
  #simulation[data-plots="off"] #analysis { display: none; }
  #analysis { min-height: 0; overflow-y: auto; border-left: 1px solid #dce2e3; background: #fafcfc; }
  .analysis-header { display: flex; align-items: center; justify-content: space-between; padding: 8px 16px; border-bottom: 1px solid #dce2e3; font-size: 11px; }
  .analysis-header .segments span { padding: 3px 10px; }
  .plot-section { padding: 12px 16px 10px; border-bottom: 1px solid #dce2e3; }
  .plot-section h2 { margin: 0 0 8px; font-size: 12px; font-weight: 600; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 5px; }
  .plot-section h2 > span, .plot-section h2 output { font-weight: 400; color: #5c696e; font-size: 10px; }
  #workspace-plot { height: 205px; }
  #position-plot { height: 148px; }
  #carriage-plot { height: 142px; }
  .plot-caption { font-size: 10px; line-height: 1.5; color: #5c696e; margin: 5px 0 0; }
  .plot-legend { display: flex; flex-wrap: wrap; gap: 10px; font-size: 10px; color: #5c696e; }
  .swatch { display: inline-block; width: 9px; height: 9px; margin-right: 5px; }
  .available { background: #90c5c5; } .excluded { background: #e0e5e7; }
  .plot-section .segments span { padding: 2px 7px; font-size: 10px; }
  canvas { display: block; width: 100%; height: 100%; touch-action: none; }
  #status { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; gap: 16px; padding: 24px; background: #f6f8f8e8; }
  #status[hidden] { display: none; }
  #retry { padding: 8px 12px; background: white; border: 1px solid #c5d0d2; border-radius: 4px; }
  .readout, .axes-label { position: absolute; pointer-events: none; bottom: 14px; font-size: 11px; color: #4e5b60; background: #f6f8f8e8; padding: 5px 8px; }
  .readout { left: 16px; display: flex; gap: 10px; font-variant-numeric: tabular-nums; }
  .phase-readout { position: absolute; top: 12px; left: 16px; max-width: calc(100% - 32px); font-size: 11px; color: #315e63; background: #f6f8f8e8; padding: 5px 8px; pointer-events: none; }
  .readout > span { color: #167b84; font-weight: 700; }
  .axes-label { right: 16px; }
  .playback { display: flex; align-items: center; gap: 8px; padding: 8px 16px; border-top: 1px solid #dce2e3; background: #f6f8f8; }
  #timeline { flex: 1; width: 60px; min-width: 50px; }
  #time { font-size: 11px; font-variant-numeric: tabular-nums; width: 100px; white-space: nowrap; text-align: center; }
  #play .play-icon { display: none; }
  #play[data-paused] .play-icon { display: block; }
  #play[data-paused] .pause-icon { display: none; }
  #model-details { position: relative; border-top: 1px solid #dce2e3; font-size: 11px; background: #f6f8f8; }
  summary { cursor: pointer; padding: 10px 24px; }
  summary > span { color: #647277; margin-left: 16px; }
  .model-notes { position: absolute; z-index: 3; bottom: 100%; left: 0; width: 100%; max-height: min(340px, 60dvh); overflow-y: auto; padding: 16px 24px; background: #fffffff5; border-block: 1px solid #c5d0d2; line-height: 1.6; box-shadow: 0 -5px 14px #0001; }
  .model-notes p { max-width: 880px; margin: 8px 0; }
  #ranges { display: flex; gap: 20px; flex-wrap: wrap; margin: 12px 0; font-variant-numeric: tabular-nums; }
  #ranges div { display: flex; gap: 8px; }
  #ranges dt { font-weight: 600; }
  #ranges dd { margin: 0; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
  @media (max-width: 800px) {
    .manual-axes { grid-template-columns: minmax(0, 1fr); gap: 5px; }
    #manual-controls { padding: 5px 10px; }
    .workbench { display: flex; flex-direction: column; overflow-y: auto; }
    #viewport { flex: 0 0 calc(100% - 34px); min-height: 300px; }
    #simulation[data-manual="true"] #viewport { min-height: 180px; }
    #analysis { flex: none; overflow: visible; border-left: 0; border-top: 1px solid #dce2e3; display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); }
    .analysis-header { grid-column: 1 / -1; }
    #simulation[data-plots="off"] #viewport { flex: 1; }
    .axes-label { display: none; }
  }
  @media (max-width: 540px) {
    header, .toolbar, .playback { padding-inline: 8px; gap: 4px; }
    h1 span { display: block; margin: 3px 0 0; }
    .toolbar { gap: 6px; }
    .segments span { padding: 6px 8px; }
    select { font-size: 12px; padding-inline: 5px; }
    .axes-label { display: none; }
    .readout { left: 8px; bottom: 8px; }
    #time { width: 84px; font-size: 10px; }
    #reset { display: none; }
    summary { padding-inline: 14px; }
    summary > span { margin-left: 7px; }
  }
</style>
